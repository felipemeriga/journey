---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

const description =
  "Felipe Ramos da Silva — senior software engineer in Rust and Go. Distributed systems, real-time media and the infrastructure underneath them. Systems that answer in milliseconds.";

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Felipe Ramos da Silva',
  jobTitle: 'Senior Rust & Go Engineer',
  url: Astro.site?.href,
  email: 'felipe.meriga@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Londrina', addressRegion: 'Paraná', addressCountry: 'BR' },
  knowsAbout: ['Rust', 'Go', 'Distributed systems', 'Real-time media', 'GPU video', 'WebRTC', 'AI agents', 'RAG'],
  sameAs: [
    'https://github.com/felipemeriga',
    'https://linkedin.com/in/felipersil',
    'https://www.youtube.com/@felipemerigadon',
    'https://www.instagram.com/f.meriga/',
    'https://felipemeriga.hashnode.dev/',
  ],
};
---
<Base title="Felipe Ramos da Silva — Senior Rust & Go Engineer" description={description} jsonLd={personSchema}>
<div style="display:flex;flex-direction:column">

  <Nav home={true} />

  <section id="top" style="min-height:calc(100vh - 56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr))">
    <div style="padding:clamp(40px,7vw,104px) clamp(20px,5vw,72px);display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-8)">
      <div>
        <div style="display:flex;gap:var(--space-2);align-items:center;font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700)"><span style="width:10px;height:10px;background:var(--color-accent);display:inline-block"></span>Senior Rust &amp; Go Engineer · Real-time media · Distributed systems · Applied AI</div>
        <h1 style="font-size:clamp(48px,6.4vw,112px);line-height:0.98;letter-spacing:-0.03em;margin:var(--space-4) 0 0 -0.058em"><span data-reveal style="display:block;animation-delay:.05s">Systems that</span><span data-reveal style="display:block;animation-delay:.18s">answer in</span><span data-reveal style="display:block;color:var(--color-accent);animation-delay:.31s">milliseconds.</span></h1>
      </div>
      <div>
        <p data-reveal style="font-size:17px;line-height:28px;max-width:52ch;margin:0;animation-delay:.45s">I'm Felipe, a senior software engineer working in Rust and Go. I build backends that can't be late: real-time video, live-streaming platforms, and the distributed systems under them. Lately I've been putting AI into production too — agents, long-term memory, RAG.</p>
        <div data-reveal style="display:flex;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-6);animation-delay:.55s">
          <a class="btn btn-primary" href="#work" style="justify-content:flex-start;min-width:180px">See the work →</a>
          <a class="btn btn-secondary" href="/assets/Felipe-Ramos-da-Silva-Resume.pdf" download="Felipe-Ramos-da-Silva-Resume.pdf" style="justify-content:flex-start;min-width:180px">Résumé (PDF)</a>
        </div>
      </div>
    </div>
    <div style="position:relative;background:var(--color-accent);min-height:460px;overflow:hidden">
      <canvas id="hero-canvas" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;display:block"></canvas>
    </div>
  </section>

  <div style="border-top:2px solid var(--color-divider);padding:var(--space-3) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--space-4);font-size:13px;letter-spacing:0.08em;text-transform:uppercase;font-feature-settings:'tnum' 1">
    <div><span style="color:var(--color-neutral-700)">Core</span><br><strong>Rust · Go · Distributed systems</strong></div>
    <div><span style="color:var(--color-neutral-700)">Specialty</span><br><strong>Real-time media · GPU video</strong></div>
    <div><span style="color:var(--color-neutral-700)">Also</span><br><strong>Cloud · Frontend · Web3 · AI agents</strong></div>
    <div><span style="color:var(--color-neutral-700)">Base</span><br><strong>Londrina, BR · Remote US / EU</strong></div>
  </div>

  <section id="work" style="border-top:2px solid var(--color-divider);padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px)">
    <div style="max-width:1200px;margin:0 auto">
      <div data-reveal style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700);margin-bottom:var(--space-8)">01 — Professional highlights</div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:0 clamp(16px,3vw,48px);border-top:2px solid var(--color-divider)">
        <article data-reveal style="padding:var(--space-8) 0;border-bottom:2px solid var(--color-divider);display:flex;flex-direction:column;gap:var(--space-4);min-width:0">
          <div style="display:flex;justify-content:space-between;gap:var(--space-3);font-size:13px;letter-spacing:0.08em;text-transform:uppercase;font-feature-settings:'tnum' 1"><span style="color:var(--color-accent-700)">Cosm · via Kake</span><span style="color:var(--color-neutral-700)">May 2025 — present</span></div>
          <h3 style="font-size:clamp(24px,2.4vw,32px);line-height:1.1;margin:0">GPU-accelerated 8K virtual camera at 60 fps</h3>
          <div style="position:relative;height:220px;border:2px solid var(--color-divider);background:var(--color-surface)"><canvas id="cosm-canvas" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;display:block"></canvas></div>
          <p style="font-size:15px;line-height:24px;margin:0">The interactive video player for Cosm's live <strong>NHL</strong> broadcasts. A Rust engine takes the <strong>8K fisheye</strong> feed from the arena cameras, lets each viewer point their own virtual camera, corrects the lens on the GPU, and streams it back inside a <strong>16.7 ms</strong> frame budget.</p>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:var(--space-2);font-size:15px;line-height:24px">
            <li style="display:grid;grid-template-columns:10px 1fr;gap:var(--space-3);align-items:start"><span style="width:10px;height:10px;background:var(--color-accent);margin-top:7px"></span><span>Live puck and player tracking drives the camera, so it follows the play by itself: lock onto the puck, or pick a player and it stays with them. An <strong>auto-tally director</strong> even cuts between the arena cameras on its own, a beat ahead of the action.</span></li>
            <li style="display:grid;grid-template-columns:10px 1fr;gap:var(--space-3);align-items:start"><span style="width:10px;height:10px;background:var(--color-accent);margin-top:7px"></span><span>To keep up, I split the 8K decode across <strong>both of the GPU's NVDEC engines</strong> and re-synced the halves by timestamp. It holds a <strong>steady 60 fps with zero dropped frames</strong>, even when the puck races end to end.</span></li>
          </ul>
          <div style="display:flex;flex-wrap:wrap;gap:var(--space-1)"><span class="tag tag-neutral">Rust</span><span class="tag tag-neutral">Go</span><span class="tag tag-neutral">C++</span><span class="tag tag-neutral">CUDA</span><span class="tag tag-neutral">NVDEC / NVENC</span><span class="tag tag-neutral">HEVC</span><span class="tag tag-neutral">WebRTC</span><span class="tag tag-neutral">AWS</span></div>
        </article>
        <article data-reveal style="padding:var(--space-8) 0;border-bottom:2px solid var(--color-divider);display:flex;flex-direction:column;gap:var(--space-4);min-width:0">
          <div style="display:flex;justify-content:space-between;gap:var(--space-3);font-size:13px;letter-spacing:0.08em;text-transform:uppercase;font-feature-settings:'tnum' 1"><span style="color:var(--color-accent-700)">FOX · via X-Team</span><span style="color:var(--color-neutral-700)">Mar 2021 — May 2025</span></div>
          <h3 style="font-size:clamp(24px,2.4vw,32px);line-height:1.1;margin:0">Live-streaming backend, from 6 minutes to 10 seconds</h3>
          <div style="position:relative;height:220px;border:2px solid var(--color-divider);background:var(--color-surface)"><canvas id="fox-canvas" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;display:block"></canvas></div>
          <p style="font-size:15px;line-height:24px;margin:0">When <strong>Fox Sports</strong> and other FOX channels go out as live streams across the US, this is what keeps watch. A Go service pulls each channel's encoding, manifests, ad insertion and viewer data into one picture and re-checks every stream on a loop, so an operator spots trouble in seconds instead of hearing it from viewers.</p>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:var(--space-2);font-size:15px;line-height:24px">
            <li style="display:grid;grid-template-columns:10px 1fr;gap:var(--space-3);align-items:start"><span style="width:10px;height:10px;background:var(--color-accent);margin-top:7px"></span><span>The full check ran once every six minutes when I picked it up. Profiling with pprof, heap and trace analysis showed it was rebuilding the same work on every pass; fixing that got it down to <strong>~10 seconds, and 60% less CPU and memory</strong>.</span></li>
            <li style="display:grid;grid-template-columns:10px 1fr;gap:var(--space-3);align-items:start"><span style="width:10px;height:10px;background:var(--color-accent);margin-top:7px"></span><span>Every provider sent its data in a different shape, so I normalized it into one model, then used it to confirm <strong>dynamic ad insertion</strong> was landing correctly across the streaming, encoding and ad systems.</span></li>
          </ul>
          <div style="display:flex;flex-wrap:wrap;gap:var(--space-1)"><span class="tag tag-neutral">Go</span><span class="tag tag-neutral">Rust</span><span class="tag tag-neutral">TypeScript</span><span class="tag tag-neutral">Kubernetes</span><span class="tag tag-neutral">AWS</span><span class="tag tag-neutral">HLS / DASH</span><span class="tag tag-neutral">SRT</span><span class="tag tag-neutral">pprof</span></div>
        </article>
      </div>
    </div>
  </section>

  <section id="projects" style="border-top:2px solid var(--color-divider);padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px)">
    <div style="max-width:1200px;margin:0 auto">
      <div data-reveal style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700);margin-bottom:var(--space-8)">02 — Featured projects</div>
      <div id="projects-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2px;background:var(--color-divider);border:2px solid var(--color-divider)">
        <!-- project cards rendered by portfolio.js -->
      </div>
    </div>
  </section>

  <section id="timeline" style="border-top:2px solid var(--color-divider);padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px)">
    <div style="max-width:1200px;margin:0 auto">
      <div data-reveal style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700);margin-bottom:var(--space-6)">03 — Career timeline</div>
      <div class="tl-anim" style="position:relative;height:72px;border-top:2px solid var(--color-divider);border-bottom:2px solid var(--color-divider);margin-bottom:var(--space-6)"><canvas id="tl-canvas" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;display:block"></canvas></div>
      <div id="timeline-rows" style="display:flex;flex-direction:column">
        <!-- role rows rendered by portfolio.js -->
      </div>
    </div>
  </section>

  <section id="opensource" style="border-top:2px solid var(--color-divider);padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px)">
    <div style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:clamp(24px,4vw,64px)">
      <div>
        <div data-reveal style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700);margin-bottom:var(--space-4)">04 — Open source</div>
        <p style="font-size:15px;line-height:24px;max-width:44ch;margin:0 0 var(--space-4)">Rust systems programming, a blockchain, microservice references, embedded work, and AI tooling. It's all on GitHub.</p>
        <a class="btn btn-secondary" href="https://github.com/felipemeriga" target="_blank" rel="noreferrer" style="justify-content:flex-start;min-width:200px">github.com/felipemeriga →</a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:var(--space-4);align-content:start">
        <div data-reveal style="border-top:2px solid var(--color-divider);padding-top:var(--space-3)"><div id="stat-repos" style="font-family:var(--font-heading);font-weight:800;font-size:clamp(40px,4vw,56px);line-height:1;color:var(--color-accent);letter-spacing:-0.03em;font-feature-settings:'tnum' 1">80+</div><div style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin-top:var(--space-2)">Public repos</div></div>
        <div data-reveal style="border-top:2px solid var(--color-divider);padding-top:var(--space-3)"><div id="stat-followers" style="font-family:var(--font-heading);font-weight:800;font-size:clamp(40px,4vw,56px);line-height:1;color:var(--color-accent);letter-spacing:-0.03em;font-feature-settings:'tnum' 1">169</div><div style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin-top:var(--space-2)">Followers</div></div>
        <div data-reveal style="border-top:2px solid var(--color-divider);padding-top:var(--space-3)"><div id="stat-stars" style="font-family:var(--font-heading);font-weight:800;font-size:clamp(40px,4vw,56px);line-height:1;color:var(--color-accent);letter-spacing:-0.03em;font-feature-settings:'tnum' 1">75</div><div style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin-top:var(--space-2)">Stars · socket-flow</div></div>
        <div data-reveal style="border-top:2px solid var(--color-divider);padding-top:var(--space-3)"><div style="font-family:var(--font-heading);font-weight:800;font-size:clamp(40px,4vw,56px);line-height:1;color:var(--color-accent);letter-spacing:-0.03em">crates.io</div><div style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin-top:var(--space-2)">Published · socket-flow</div></div>
      </div>
    </div>
  </section>

  <section id="content" style="border-top:2px solid var(--color-divider);padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px)">
    <div style="max-width:1200px;margin:0 auto">
      <div data-reveal style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700);margin-bottom:var(--space-6)">05 — Content &amp; community</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:0 var(--space-4);border-top:2px solid var(--color-divider)">
        <a class="content-link" data-reveal href="https://felipemeriga.hashnode.dev/" target="_blank" rel="noreferrer" style="color:inherit;text-decoration:none;padding:var(--space-4) 0;border-bottom:1px solid var(--color-divider);display:flex;flex-direction:column;gap:var(--space-2)"><span style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700)">Blog</span><strong style="font-size:20px;line-height:1.2">Writing on Hashnode</strong><span style="font-size:14px;line-height:22px">Long-form posts on Rust, Go, real-time systems and AI tooling, over on Hashnode.</span></a>
        <a class="content-link" data-reveal href="https://www.youtube.com/@felipemerigadon" target="_blank" rel="noreferrer" style="color:inherit;text-decoration:none;padding:var(--space-4) 0;border-bottom:1px solid var(--color-divider);display:flex;flex-direction:column;gap:var(--space-2)"><span style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700)">YouTube · EN</span><strong style="font-size:20px;line-height:1.2">@felipemerigadon</strong><span style="font-size:14px;line-height:22px">Engineering topics, tooling, and hands-on programming.</span></a>
        <a class="content-link" data-reveal href="https://www.youtube.com/@felipemerigadon" target="_blank" rel="noreferrer" style="color:inherit;text-decoration:none;padding:var(--space-4) 0;border-bottom:1px solid var(--color-divider);display:flex;flex-direction:column;gap:var(--space-2)"><span style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700)">YouTube · PT</span><strong style="font-size:20px;line-height:1.2">Careers abroad</strong><span style="font-size:14px;line-height:22px">Helping Brazilian engineers find jobs outside Brazil, build personal branding, and stay healthy at work.</span></a>
        <a class="content-link" data-reveal href="https://www.instagram.com/f.meriga/" target="_blank" rel="noreferrer" style="color:inherit;text-decoration:none;padding:var(--space-4) 0;border-bottom:1px solid var(--color-divider);display:flex;flex-direction:column;gap:var(--space-2)"><span style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700)">Instagram</span><strong style="font-size:20px;line-height:1.2">@f.meriga</strong><span style="font-size:14px;line-height:22px">Behind the scenes of the work and life as a remote engineer.</span></a>
      </div>
    </div>
  </section>

  <section id="education" style="border-top:2px solid var(--color-divider);padding:clamp(40px,5vw,64px) clamp(20px,5vw,72px)">
    <div class="edu-grid" style="max-width:1200px;margin:0 auto">
      <div style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700)">06 — Education</div>
      <div style="display:flex;flex-direction:column;gap:var(--space-3);font-size:15px;line-height:24px">
        <div><strong>BEng, Electrical Engineering</strong> — State University of Londrina (UEL) · 2011–2016<br><span style="color:var(--color-neutral-700)">Specialization: Embedded Software Development</span></div>
        <div><strong>Technical Course, Chemistry</strong> — Escola Técnica Estadual Conselheiro Antônio Prado · 2007–2009</div>
        <div style="color:var(--color-neutral-700)">Languages: English, Portuguese and Spanish (native / bilingual) · Italian (professional) · Japanese (elementary)</div>
      </div>
    </div>
  </section>

  <section id="contact" style="background:var(--color-accent);color:var(--color-bg);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr))">
    <div style="padding:clamp(40px,5vw,72px) clamp(20px,5vw,72px);display:flex;flex-direction:column;justify-content:center;gap:var(--space-6)">
      <div>
        <div style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:var(--space-3)">07 — Hire me</div>
        <h2 data-reveal style="font-size:clamp(40px,5.6vw,88px);line-height:0.98;letter-spacing:-0.03em;margin:0 0 0 -0.058em;color:var(--color-bg);max-width:14ch">Got something hard to build? Let's talk.</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:var(--space-4)">
        <p style="font-size:17px;line-height:28px;max-width:46ch;margin:0">I'm open to senior Rust / Go roles in distributed systems, backend, and real-time media. Remote, working with teams in the US and Europe.</p>
        <div style="display:flex;flex-direction:column;font-family:var(--font-heading);font-weight:800;font-size:clamp(20px,2.2vw,28px);line-height:1.3">
          <a class="contact-link" href="mailto:felipe.meriga@gmail.com" style="color:var(--color-bg);text-decoration:none;border-top:2px solid var(--color-bg);padding:var(--space-2) 0">felipe.meriga@gmail.com</a>
          <a class="contact-link" href="https://linkedin.com/in/felipersil" target="_blank" rel="noreferrer" style="color:var(--color-bg);text-decoration:none;border-top:2px solid var(--color-bg);padding:var(--space-2) 0">linkedin.com/in/felipersil</a>
          <a class="contact-link" href="https://github.com/felipemeriga" target="_blank" rel="noreferrer" style="color:var(--color-bg);text-decoration:none;border-top:2px solid var(--color-bg);padding:var(--space-2) 0">github.com/felipemeriga</a>
          <a class="contact-link" href="/assets/Felipe-Ramos-da-Silva-Resume.pdf" download="Felipe-Ramos-da-Silva-Resume.pdf" style="color:var(--color-bg);text-decoration:none;border-top:2px solid var(--color-bg);border-bottom:2px solid var(--color-bg);padding:var(--space-2) 0">Download résumé (PDF) ↓</a>
        </div>
      </div>
    </div>
    <div class="grayscale" style="overflow:hidden;min-height:100%"><img src="/assets/portrait.jpg" alt="Felipe Ramos da Silva" style="width:100%;height:100%;object-fit:cover;object-position:50% 22%;display:block"></div>
  </section>

  <footer style="padding:var(--space-4) clamp(20px,5vw,72px);display:flex;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap;font-size:13px;letter-spacing:0.04em;color:var(--color-neutral-700);font-feature-settings:'tnum' 1">
    <span>Felipe Ramos da Silva · Londrina, Paraná, Brazil</span><span>Rust · Go · Distributed systems · Real-time media · Applied AI</span>
  </footer>
</div>

<script>
  import '../scripts/portfolio.js';
</script>
</Base>
