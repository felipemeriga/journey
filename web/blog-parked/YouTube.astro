---
// Lazy YouTube embed (facade): renders the thumbnail + play button, and only
// loads the YouTube iframe on click — keeps posts fast (no YT scripts on load)
// while still being a real, playable embed. Good for Core Web Vitals + SEO.
interface Props {
  id: string;        // YouTube video id
  title: string;     // accessible title / caption
}
const { id, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<figure class="yt" style="margin:var(--space-4) 0;">
  <div
    class="yt-facade"
    data-id={id}
    data-title={title}
    role="button"
    tabindex="0"
    aria-label={`Play video: ${title}`}
    style={`position:relative;aspect-ratio:16/9;background:#000 url('${thumb}') center/cover no-repeat;border:2px solid var(--color-divider);cursor:pointer;display:block;width:100%`}
  >
    <span aria-hidden="true" style="position:absolute;inset:0;display:grid;place-items:center">
      <span style="width:68px;height:48px;background:var(--color-accent);display:grid;place-items:center">
        <span style="width:0;height:0;border-style:solid;border-width:11px 0 11px 19px;border-color:transparent transparent transparent var(--color-bg)"></span>
      </span>
    </span>
  </div>
  <figcaption style="font-size:13px;color:var(--color-neutral-700);margin-top:var(--space-2)">{title}</figcaption>
</figure>

<script>
  // Delegate: swap facade → iframe on click/Enter. Runs once, covers all embeds.
  const activate = (el: HTMLElement) => {
    const id = el.dataset.id, title = el.dataset.title || 'YouTube video';
    const iframe = document.createElement('iframe');
    iframe.width = '100%';
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.title = title;
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    el.innerHTML = '';
    el.appendChild(iframe);
  };
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('.yt-facade') as HTMLElement | null;
    if (el && el.dataset.id) activate(el);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const el = (e.target as HTMLElement).closest?.('.yt-facade') as HTMLElement | null;
    if (el && el.dataset.id) { e.preventDefault(); activate(el); }
  });
</script>
