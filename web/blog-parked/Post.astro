---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  videoId?: string;
}
const { title, description, pubDate, updatedDate, tags = [], videoId } = Astro.props;
const fmt = (d: Date) => new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
const url = new URL(Astro.url.pathname, Astro.site);

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Felipe Ramos da Silva', url: Astro.site?.href },
  mainEntityOfPage: url.href,
  keywords: tags.join(', '),
};
const videoObject = videoId && {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  uploadDate: pubDate.toISOString(),
  thumbnailUrl: [`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`],
  embedUrl: `https://www.youtube.com/embed/${videoId}`,
  contentUrl: `https://www.youtube.com/watch?v=${videoId}`,
};
const jsonLd = videoObject ? [blogPosting, videoObject] : blogPosting;
---
<Base title={`${title} — Felipe Ramos da Silva`} description={description} type="article" jsonLd={jsonLd}>
  <Nav />
  <article style="max-width:800px;margin:0 auto;padding:clamp(40px,6vw,80px) clamp(20px,5vw,72px)">
    <a href="/blog" style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700);text-decoration:none">← All posts</a>
    <div style="display:flex;gap:var(--space-3);align-items:center;font-size:13px;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-neutral-700);font-feature-settings:'tnum' 1;margin-top:var(--space-6)">
      <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      {tags.length > 0 && <span aria-hidden="true">·</span>}
      {tags.map((t) => <span class="tag tag-neutral">{t}</span>)}
    </div>
    <h1 style="font-size:clamp(34px,5vw,64px);line-height:1.02;letter-spacing:-0.03em;margin:var(--space-3) 0 var(--space-6) -0.03em">{title}</h1>
    <p style="font-size:19px;line-height:30px;color:var(--color-neutral-700);margin:0 0 var(--space-8);max-width:68ch">{description}</p>
    <hr style="border:0;height:2px;background:var(--color-divider);margin:0 0 var(--space-8)" />
    <div class="prose">
      <slot />
    </div>
    {updatedDate && (
      <p style="margin-top:var(--space-8);font-size:13px;color:var(--color-neutral-700)">Updated {fmt(updatedDate)}</p>
    )}
    <hr style="border:0;height:2px;background:var(--color-divider);margin:var(--space-8) 0" />
    <a class="btn btn-secondary" href="/blog" style="justify-content:flex-start">← Back to all posts</a>
  </article>
  <footer style="border-top:2px solid var(--color-divider);padding:var(--space-4) clamp(20px,5vw,72px);display:flex;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap;font-size:13px;letter-spacing:0.04em;color:var(--color-neutral-700)">
    <span>Felipe Ramos da Silva · Londrina, Paraná, Brazil</span><a href="/" style="color:inherit">felipemeriga.dev</a>
  </footer>
</Base>
