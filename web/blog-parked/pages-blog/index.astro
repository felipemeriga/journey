---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const fmt = (d: Date) => new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(d);
---
<Base title="Blog — Felipe Ramos da Silva" description="Writing and videos on Rust, Go, real-time systems, distributed systems and AI tooling.">
  <Nav />
  <section style="max-width:900px;margin:0 auto;padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px)">
    <div style="font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent-700);margin-bottom:var(--space-3)">Blog</div>
    <h1 style="font-size:clamp(40px,6vw,80px);line-height:0.98;letter-spacing:-0.03em;margin:0 0 var(--space-3) -0.03em">Writing &amp; videos.</h1>
    <p style="font-size:17px;line-height:28px;color:var(--color-neutral-700);max-width:60ch;margin:0 0 var(--space-8)">Rust, Go, real-time and distributed systems, and applied AI — plus the occasional video. <a href="/rss.xml">RSS</a>.</p>

    {posts.length === 0 && (
      <p style="color:var(--color-neutral-700)">No posts yet — first one is on the way.</p>
    )}

    <div style="border-top:2px solid var(--color-divider)">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} style="color:inherit;text-decoration:none;display:grid;grid-template-columns:minmax(110px,150px) 1fr;gap:var(--space-4);padding:var(--space-6) 0;border-bottom:2px solid var(--color-divider);align-items:baseline" class="content-link">
          <time datetime={post.data.pubDate.toISOString()} style="font-size:13px;letter-spacing:0.04em;color:var(--color-neutral-700);font-feature-settings:'tnum' 1">{fmt(post.data.pubDate)}</time>
          <div style="display:flex;flex-direction:column;gap:var(--space-2);min-width:0">
            <h2 style="font-size:clamp(22px,2.6vw,30px);line-height:1.12;margin:0">{post.data.title}{post.data.videoId && <span class="tag tag-accent" style="margin-left:var(--space-3);vertical-align:middle">Video</span>}</h2>
            <p style="font-size:15px;line-height:24px;color:var(--color-neutral-700);margin:0;max-width:60ch">{post.data.description}</p>
            <div style="display:flex;flex-wrap:wrap;gap:var(--space-1);margin-top:var(--space-1)">{post.data.tags.map((t) => <span class="tag tag-neutral">{t}</span>)}</div>
          </div>
        </a>
      ))}
    </div>
  </section>
  <footer style="border-top:2px solid var(--color-divider);padding:var(--space-4) clamp(20px,5vw,72px);display:flex;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap;font-size:13px;letter-spacing:0.04em;color:var(--color-neutral-700)">
    <span>Felipe Ramos da Silva · Londrina, Paraná, Brazil</span><a href="/" style="color:inherit">← Home</a>
  </footer>
</Base>
